# ===================================================
# VetiCare - Environment & Deployment Configuration
# ===================================================

# Supabase Credentials (Required)
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Server Configuration
# The port the backend server listens on (Cloud providers like Render/Railway/Heroku set this automatically)
PORT=3000

# Server Host Binding (Defaults to 0.0.0.0 for containerized and cloud deployments)
HOST=0.0.0.0

# CORS Configuration (Optional)
# In production, set to your frontend URL (e.g., https://my-vet-clinic.com) or comma-separated URLs
# Leave as * to permit all origins
CORS_ORIGIN=*

# Frontend API URL (Optional)
# Only required if frontend and backend are deployed on completely separate domains
# (e.g. Frontend on Vercel, Backend on Railway). For full-stack deployment, leave as /api
VITE_API_URL=/api

